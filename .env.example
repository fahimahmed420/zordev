# Public site URL (canonical, apex)
NEXT_PUBLIC_SITE_URL=https://zordev.com

# Booking: leave empty to use the built-in scheduler, or set a Cal.com link to embed Cal instead
NEXT_PUBLIC_BOOKING_URL=

# Email (Resend, verified on send.zordev.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=fahim@zordev.com
CONTACT_FROM_EMAIL="Fahim at Zordev <fahim@zordev.com>"

# Spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics (Umami Cloud website ID)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# CRM: Google Apps Script / Make / Zapier webhook that appends a row per lead
LEAD_WEBHOOK_URL=
